# ============================================
# GridSpace Backend - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ============================================
# REQUIRED - Core Configuration
# ============================================
MONGO_URI=mongodb://localhost:27017/gridspace
JWT_SECRET=your-super-secret-jwt-key-minimum-16-characters-with-mixed-case-numbers-symbols
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# ============================================
# Application Settings
# ============================================
NODE_ENV=development
PORT=5002

# ============================================
# CORS & Frontend Configuration
# ============================================
# Development defaults (localhost)
# Production: Set these to your actual production URLs
CORS_ORIGIN=http://localhost:3000,http://localhost:3001
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:5002

# Production Example:
# CORS_ORIGIN=https://work.gridspace.com.ng,https://www.gridspace.com.ng
# FRONTEND_URL=https://work.gridspace.com.ng
# API_URL=https://api.gridspace.com.ng

# ============================================
# JWT Token Configuration
# ============================================
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d
JWT_ISSUER=gridspace-backend
JWT_AUDIENCE=gridspace-client

# ============================================
# Security Settings
# ============================================
RATE_LIMIT_WINDOW_MS=15 * 60 * 1000
RATE_LIMIT_MAX=100

# ============================================
# Email Service Configuration
# ============================================
# Option 1: Resend (Recommended)
RESEND_API_KEY=your-resend-api-key
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=GridSpace

# Option 2: MailerSend (Alternative)
# MAILERSEND_API_KEY=your-mailersend-api-key
# MAILERSEND_FROM_EMAIL=noreply@yourdomain.com
# MAILERSEND_FROM_NAME=GridSpace

# Option 3: Nodemailer (SMTP)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password
# FROM_EMAIL=noreply@yourdomain.com
# FROM_NAME=GridSpace

# ============================================
# Google OAuth Configuration
# ============================================
# Optional - Only needed if using Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5002/api/v1/auth/google/callback

# Production Example:
# GOOGLE_REDIRECT_URI=https://api.gridspace.com.ng/api/v1/auth/google/callback

# ============================================
# Monnify Payment Gateway
# ============================================
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=your-monnify-api-key
MONNIFY_SECRET_KEY=your-monnify-secret-key
MONNIFY_CONTRACT_CODE=your-monnify-contract-code
# REQUIRED in production - No default for security
MONNIFY_WEBHOOK_SECRET=your-secure-webhook-secret-minimum-32-characters

# Production Example:
# MONNIFY_BASE_URL=https://api.monnify.com
# MONNIFY_WEBHOOK_SECRET=your-production-webhook-secret

# ============================================
# Wallet Configuration
# ============================================
WALLET_DAILY_WITHDRAWAL_LIMIT=50000
WALLET_MONTHLY_WITHDRAWAL_LIMIT=500000
WALLET_MIN_WITHDRAWAL=500
WALLET_CURRENCY=NGN

# ============================================
# Production Checklist
# ============================================
# When deploying to production, ensure these are set:
# ✓ CORS_ORIGIN (production frontend URLs)
# ✓ FRONTEND_URL (production frontend URL)
# ✓ API_URL (production API URL)
# ✓ MONNIFY_WEBHOOK_SECRET (secure secret)
# ✓ FROM_EMAIL (verified domain email)
# ✓ GOOGLE_REDIRECT_URI (production callback URL)
# ✓ NODE_ENV=production

