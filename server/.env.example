# =====================
# Core Application
# =====================
# Port number for the Express HTTP server. Defaults to 5000 when unset.
PORT=5000

# Node environment flag used for conditional logic (e.g., logging, backups).
# Common values: development, production, test
NODE_ENV=development

# Comma-separated list of allowed origins for CORS. No spaces unless intended as part of the origin.
# Example: http://localhost:3000,http://localhost:3001,https://app.yourdomain.com
CORS_ORIGIN=http://localhost:3000

# Base URL of the frontend application used for OAuth redirects and deep links.
FRONTEND_URL=http://localhost:3000

# Minimum log level emitted by Winston logger. Options: error, warn, info, http, verbose, debug, silly.
LOG_LEVEL=info

# =====================
# Database
# =====================
# MongoDB connection string. Include credentials, host(s), and database name.
# Example: mongodb+srv://username:password@cluster.mongodb.net/gridspace?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/gridspace

# =====================
# Authentication & Security
# =====================
# Secret key used to sign and verify JWT access tokens.
JWT_SECRET=replace_with_strong_random_value

# JWT token configuration
JWT_ISSUER=gridspace-backend
JWT_AUDIENCE=gridspace-client
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=7d

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX=100  # Max requests per window

# =====================
# Third-Party Integrations
# =====================
# Cloudinary credentials for media storage. All three are required for startup.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Monnify Payment Gateway (Optional - for payment processing)
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_API_KEY=MK_TEST_your_api_key
MONNIFY_SECRET_KEY=TEST_SECRET_your_secret_key
MONNIFY_CONTRACT_CODE=1234567890
MONNIFY_WEBHOOK_SECRET=gridspace_webhook_secret_2025

# Monnify wallet account number for disbursements/withdrawals
MONNIFY_WALLET_ACCOUNT_NUMBER=your_wallet_account_number

# Wallet Configuration
# Daily withdrawal limit in Naira (₦)
WALLET_DAILY_WITHDRAWAL_LIMIT=50000
# Monthly withdrawal limit in Naira (₦)
WALLET_MONTHLY_WITHDRAWAL_LIMIT=500000
# Minimum withdrawal amount in Naira (₦)
WALLET_MIN_WITHDRAWAL=500
# Wallet currency code
WALLET_CURRENCY=NGN

# Google OAuth 2.0 configuration for Google sign-in.
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# =====================
# API Configuration
# =====================
# Base URL for API calls (used by Swagger and frontend integrations)
# Defaults to http://localhost:5002 in development
# REQUIRED in production (set to your deployment URL)
API_URL=http://localhost:5002

# =====================
# Admin Seeding
# =====================
# Admin account credentials for initial setup (used by scripts/seed-admin.js)
# Required when running the seed-admin script to create the first admin user
ADMIN_EMAIL=admin@gridspace.com
ADMIN_PASSWORD=SecureAdminPassword123!
ADMIN_PHONE=+2349046575527
# Optional: Pre-generated MongoDB ObjectId for admin user
# ADMIN_USER_ID=6908b472798db11157fa6722

# =====================
# Email Delivery
# =====================
# Resend Email Service (Primary/Recommended)
# Modern email API service. Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here

# Default "from" email address shown to recipients
FROM_EMAIL=noreply@gridspace.com

# Friendly sender name that accompanies the from email
FROM_NAME=GridSpace

# Nodemailer/SMTP Configuration (Alternative to Resend)
# For custom SMTP servers or development setups when RESEND_API_KEY is not available
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Whether to use TLS/SSL. Use "true" for port 465, otherwise "false"
SMTP_SECURE=false

# SMTP authentication credentials. Required for most providers
SMTP_USER=your_smtp_username
SMTP_PASS=your_smtp_password

# Shortcut for well-known SMTP providers (e.g., gmail, outlook). Leave blank when using custom host/port
SMTP_SERVICE=gmail

# For Gmail SMTP when two-factor auth is enabled. Provide the generated app password
SMTP_APP_PASSWORD=your_gmail_app_password

# Optional address used by the nodemailer test script when sending sample emails
TEST_EMAIL=tester@example.com

# =====================
# MailerSend (Optional: legacy/test utilities)
# =====================
# Only required when running the legacy MailerSend test scripts.
MAILERSEND_API_KEY=mlsn.your_mailersend_api_key
MAILERSEND_FROM_EMAIL=noreply@yourdomain.com
MAILERSEND_FROM_NAME=GridSpace

# =====================
# Testing
# =====================
# Set to true in CI environments to skip long-running integration tests
CI=false

# Test email for development and testing
TEST_EMAIL=test@example.com
